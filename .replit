run = "npm run replit:dev"
entrypoint = "src/server.ts"
modules = ["nodejs-22", "web", "bash", "postgresql-16"]

hidden = ["dist", "node_modules", ".config"]

[nix]
channel = "stable-25_05"

[env]
CLAUDE_CONFIG_DIR = "/home/runner/workspace/.local/state/claude"
PORT = "5000"
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD = "1"
ENABLE_SCHEDULER = "false"

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm run replit:build"]
run = ["sh", "-c", "npm start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run replit:dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
