# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# On Replit, set these in Secrets instead of a .env file.
#
# DATABASE_URL and JWT_SECRET are required — the server exits at boot if
# either is missing (see src/config.ts).

# Database (NeonDB PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# Server port
PORT=3333

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-random-secret-here

# Email delivery (SendGrid)
EMAIL_FROM=noreply@civicduty.app
SENDGRID_API_KEY=

# Cron scrapers. Defaults to enabled; set to false on any instance that isn't
# a single always-on process (e.g. Replit Autoscale, or a second web replica),
# otherwise every replica scrapes the same rate-limited sources in parallel.
ENABLE_SCHEDULER=true

# Playwright browser resolution. Leave unset locally and in Docker to use
# Playwright's bundled Chromium. On Replit set PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# and the Nix chromium is picked up from PATH automatically.
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
